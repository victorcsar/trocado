# Copie para .env e preencha. Usado pelo docker compose.

# Porta em que o app abre no navegador (http://localhost:8070)
APP_PORT=8070
# Porta do Postgres na sua máquina (só 127.0.0.1), para rodar testes e o backend fora do Docker
DB_PORT=5433

POSTGRES_USER=trocado
# Gere com: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=trocado

# Segredo da sessão (mín. 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSAO_DIAS=30
# true em produção, atrás de HTTPS
COOKIE_SECURE=false

# Sua conta: criada quando o backend sobe, se ainda não existir esse e-mail
USUARIO_NOME=
USUARIO_EMAIL=
USUARIO_SENHA=

# true só na instância de demonstração (a tela de entrada oferece a conta de exemplo)
DEMO=false
