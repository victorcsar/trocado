# Para rodar o backend e os testes fora do Docker, usando o Postgres do compose
# (docker compose up -d db). Senha = POSTGRES_PASSWORD do .env da raiz; porta = DB_PORT.
DATABASE_URL="postgresql://trocado:SENHA@localhost:5433/trocado?schema=public"

JWT_SECRET=""
SESSAO_DIAS=30
COOKIE_SECURE=false
DEMO=false
